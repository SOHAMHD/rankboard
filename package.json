{
  "name": "rankboard-admin",
  "private": true,
  "scripts": {
    "setup": "npm install --prefix client",
    "api:py": "cd server-python && python -m uvicorn app.main:app --port 4000 --reload",
    "dev:py": "concurrently -n api,web -c magenta,green \"npm run api:py\" \"npm run dev --prefix client\"",
    "build:web": "npm run build --prefix client",
    "start:api": "cd server-python && python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-4000} --workers 2 --proxy-headers"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
