# Copy this file to ".env" (same folder) and fill in your real values.
# The .env file is read automatically on server start. NEVER commit .env.

# ── Database ────────────────────────────────────────────────────────
# DATABASE_URL  — Postgres connection URL (Supabase). REQUIRED: this app has no
#                 other backend, so it refuses to start without it. Accepts
#                 postgresql://, postgres:// or postgresql+psycopg:// forms.
#                 Supabase: Project settings -> Database -> Connection string
#                 (use the Session pooler, port 5432).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ── Server ──────────────────────────────────────────────────────────
# PORT          — port the API listens on (default 4000)
# JWT_SECRET    — signing key for auth tokens. REQUIRED: there is NO fallback,
#                 so the server refuses to start until this is set. Use a long
#                 random value (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
# APP_URL       — frontend base URL used in invite-email links.
# DEBUG         — set true ONLY in development to enable /docs, /redoc,
#                 /openapi.json. Leave false/unset in production.
# CORS_ORIGINS  — comma-separated browser origins allowed to call the API.
#                 Defaults to APP_URL. NEVER use "*".
# PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173
# DEBUG=false
# CORS_ORIGINS=http://localhost:5173

# ── DataForSEO (locations import only) ──────────────────────────────
# Keyword ranks are entered by hand in the Keywords grid — the app never calls
# DataForSEO at runtime. These credentials are used by ONE offline maintenance
# script, scripts/import_locations.py, which refreshes the `locations` table
# (countries / regions / cities) from DataForSEO's geo-target list.
# Safe to leave empty: the app falls back to the 249 countries baked into
# app/countries.json.
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password

# Optional — uncomment to test against DataForSEO's free mock-data sandbox:
# DATAFORSEO_BASE=https://sandbox.dataforseo.com

# ── Moz API (domain Authority panel) ────────────────────────────────
# Token for the modern JSON-RPC API (the x-moz-token header, NOT the legacy
# Access ID / Secret Key). Powers the per-project Authority panel. Leave empty
# to disable it; quota is tiny, so Moz is only called on an explicit refresh.
MOZ_API_TOKEN=

# ── Email (transactional: invites, sign-in codes, report sends) ─────
# Transport priority: SMTP (below) > Brevo API > dev outbox. Leave all
# empty to keep emails in the dev outbox (the `emails` table) instead of
# actually sending them.
#
# BREVO_API_KEY — Brevo (formerly Sendinblue) API key from
#   dashboard → SMTP & API → API Keys (starts with "xkeysib-"). Sends via
#   https://api.brevo.com/v3/smtp/email.
# EMAIL_FROM    — sender address. The address (or its domain) must be a
#   verified sender/domain in your Brevo account. Defaults to
#   "RankBoard <no-reply@example.com>".
BREVO_API_KEY=
# EMAIL_FROM=RankBoard <no-reply@yourdomain.com>
#
# BREVO_WEBHOOK_SECRET — enables the Email Log's delivery/open tracking.
#   Brevo already renders a tracking pixel into every message it sends; this is
#   what lets it tell us. Generate any long random string, then in Brevo go to
#   Transactional → Settings → Webhook and add:
#
#     https://your-server/api/webhooks/brevo?token=<the same string>
#
#   tick delivered, opened, click, hard bounce, soft bounce, blocked, spam and
#   unsubscribed. Brevo does not sign its webhooks, so this token in the URL is
#   the only thing proving an event is real — treat it like a password. Leave it
#   empty and /api/webhooks/brevo refuses every request, which is the safe
#   default: an open endpoint would let anyone forge "opened" events.
BREVO_WEBHOOK_SECRET=
#
# Alternatively, use Brevo over SMTP (or any SMTP provider) — this takes
# priority over the Brevo API when SMTP_HOST is set:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASS=your-brevo-smtp-key
# SMTP_SECURE=starttls

# ── Google Analytics 4 (GA4 traffic panel) ──────────────────────────
# Path to the Google service-account JSON key file. Leave empty to disable the
# GA4 traffic panel (the provider returns a clear "not configured" result
# instead of crashing). Each project stores its own GA4 property ID in the DB.
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json    
VITE_API_BASE_URL=https://your-backend.onrender.com

    
# ── Report cover images ─────────────────────────────────────────────
# The report email embeds a PNG of the cover page, fetched by the recipient's
# mail client over plain HTTP with no session. REPORT_ASSET_DIR is where the
# file is written; REPORT_ASSET_BASE_URL is the public URL for the same file.
#
# Point BASE_URL at the API (/api/reports/covers), not at a static directory.
# Serving these through the API avoids document-root layout, .htaccess rules,
# hotlink protection and mod_security — any of which can 403 the image and
# leave a broken picture in a client's inbox, silently.
REPORT_ASSET_BASE_URL=https://your-domain.example/api/reports/covers
