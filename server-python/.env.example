# Copy this file to ".env" (same folder) and fill in your real values.
# The .env file is read automatically on server start. NEVER commit .env.
#
# Every variable the backend reads is listed here. Anything not listed is not
# read by app/config.py — with two exceptions read directly from the
# environment: DATABASE_URL (app/db.py) and SKIP_DB_INIT (app/db.py), both
# documented below.

# ── Database ────────────────────────────────────────────────────────
# DATABASE_URL  — Postgres connection URL (Supabase). REQUIRED: this app has no
#                 other backend, so it refuses to start without it. Accepts
#                 postgresql://, postgres:// or postgresql+psycopg:// forms.
#                 Supabase: Project settings -> Database -> Connection string
#                 (use the Session pooler, port 5432).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# SKIP_DB_INIT  — set to 1 to skip the schema/seed pass that app/db.py runs at
#                 import. The DDL is idempotent but every worker process runs
#                 it, so on a multi-worker deploy the workers race each other.
#                 Set SKIP_DB_INIT=1 on the app service and run migrations once
#                 as a separate step. Leave unset for local development.
# SKIP_DB_INIT=1

# ── Server ──────────────────────────────────────────────────────────
# PORT          — port the API listens on (default 4000)
# JWT_SECRET    — signing key for auth tokens. REQUIRED: there is NO fallback,
#                 so the server refuses to start until this is set. Use a long
#                 random value (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
# APP_URL       — frontend base URL used in invite-email links and as the
#                 default base for EMAIL_LOGO_URL / REPORT_ASSET_BASE_URL.
#                 No trailing slash.
# AGENCY_NAME   — agency name shown in emails and on generated reports.
#                 Defaults to "InfyApp Development" — the client MUST override
#                 this with their own name.
# DEBUG         — set true ONLY in development to enable /docs, /redoc,
#                 /openapi.json. Leave false/unset in production.
# CORS_ORIGINS  — comma-separated browser origins allowed to call the API.
#                 Defaults to APP_URL. No trailing slash (it would never match
#                 an Origin header). NEVER use "*".
# PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173
# AGENCY_NAME=Your Agency Name
# DEBUG=false
# CORS_ORIGINS=http://localhost:5173

# ── Moz API (Domain Authority panel) ────────────────────────────────
# MOZ_API_TOKEN  — token for the modern JSON-RPC API (the x-moz-token header).
#   Powers the per-project Authority panel. Leave empty to disable it; quota is
#   tiny, so Moz is only called on an explicit refresh.
# MOZ_ACCESS_ID / MOZ_SECRET_KEY — the legacy Mozscape Access ID + Secret Key
#   pair, kept as a fallback for accounts that still authenticate that way. If
#   MOZ_API_TOKEN is set you do not need these.
MOZ_API_TOKEN=
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=

# ── Email (transactional: invites, sign-in codes, report sends) ─────
# Transport priority: SMTP (below) > Brevo API > dev outbox. Leave all
# empty to keep emails in the dev outbox (the `emails` table) instead of
# actually sending them.
#
# BREVO_API_KEY — Brevo (formerly Sendinblue) API key from
#   dashboard → SMTP & API → API Keys (starts with "xkeysib-"). Sends via
#   https://api.brevo.com/v3/smtp/email.
# EMAIL_FROM    — sender address. The address (or its domain) must be a
#   verified sender/domain in your Brevo account. Defaults to
#   "SEO Dashboard <no-reply@example.com>".
BREVO_API_KEY=
# EMAIL_FROM=RankBoard <no-reply@yourdomain.com>
#
# EMAIL_LOGO_URL — absolute URL of the logo image embedded at the top of every
#   email. Must be publicly reachable with no session: mail clients fetch it
#   cold. Defaults to "<APP_URL>/infapp-logo.png".
# SUPPORT_EMAIL  — "reply to a human" address printed in email footers.
#   Defaults to info@infyappdevelopment.com — the client MUST override this.
# UNSUBSCRIBE_URL — link in the email footer. Defaults to
#   https://infyappdevelopment.com/unsubscribe — the client MUST override this.
# EMAIL_LOGO_URL=https://your-domain.example/logo.png
# SUPPORT_EMAIL=support@yourdomain.com
# UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe
#
# BREVO_WEBHOOK_SECRET — enables the Email Log's delivery/open tracking.
#   Brevo already renders a tracking pixel into every message it sends; this is
#   what lets it tell us. Generate any long random string, then in Brevo go to
#   Transactional → Settings → Webhook and add:
#
#     https://your-server/api/webhooks/brevo?token=<the same string>
#
#   tick delivered, opened, click, hard bounce, soft bounce, blocked, spam and
#   unsubscribed. Brevo does not sign its webhooks, so this token in the URL is
#   the only thing proving an event is real — treat it like a password. Leave it
#   empty and /api/webhooks/brevo refuses every request, which is the safe
#   default: an open endpoint would let anyone forge "opened" events.
BREVO_WEBHOOK_SECRET=
#
# Alternatively, use Brevo over SMTP (or any SMTP provider) — this takes
# priority over the Brevo API when SMTP_HOST is set:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASS=your-brevo-smtp-key
# SMTP_SECURE=starttls

# ── Google Analytics 4 + Search Console ─────────────────────────────
# Path to the Google service-account JSON key file. Leave empty to disable the
# GA4 traffic panel and the Search Console panels (the providers return a clear
# "not configured" result instead of crashing). Each project stores its own GA4
# property ID and GSC site URL in the DB. The service account must be granted
# Viewer on the GA4 property and added as a user on the Search Console property.
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# ── Report cover images ─────────────────────────────────────────────
# The report email embeds a PNG of the cover page, fetched by the recipient's
# mail client over plain HTTP with no session. REPORT_ASSET_DIR is where the
# file is written; REPORT_ASSET_BASE_URL is the public URL for the same file.
#
# Point BASE_URL at the API (/api/reports/covers), not at a static directory.
# Serving these through the API avoids document-root layout, .htaccess rules,
# hotlink protection and mod_security — any of which can 403 the image and
# leave a broken picture in a client's inbox, silently.
#
# REPORT_ASSET_DIR — on-disk write path. Defaults to server-python/assets/public.
#   On a host with an ephemeral filesystem (Render's default), covers vanish on
#   every restart; point this at a mounted persistent disk if that matters.
# REPORT_ASSET_DIR=/var/data/report-assets
REPORT_ASSET_BASE_URL=https://your-domain.example/api/reports/covers
